// Shared deterministic scene for the autotest eval (see context/reports/2026-07-03-autotest-harness-revival.md).
// Delays are seconds after the gameplay screen loads. Used by EVALGolden.script and EVALSmoke.script.

toggledebug_lines false
1 setsky midday
2 cam_fov 1.5
3 play_teleport 3848 80 3848

// Places a 16x16 grid of one-of-every-block 10 above the player - deterministic foreground geometry
6 blockgrid

// Move above the grid and look straight down at it
8 play_teleport 3848 100 3848
8.1 cam_rotate 0 -1.5
