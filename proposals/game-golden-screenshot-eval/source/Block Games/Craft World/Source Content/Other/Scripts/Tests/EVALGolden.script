// Captures the golden screenshot for the autotest eval, then exits.
// Launch: BlockWorld.exe autotest testingmode fixedtimestep script EVALGolden
// Output: blockgametests\EVALGoldenShot.png (next to the exe). The eval runner
// moves it into tools\autotest-eval\goldens\.

script EVALScene

16 test_prtscn EVALGoldenShot 256 256

18 test_writeheading EVALGolden capture run
18.1 test_writestart
18.2 test_writeend

20 exit
